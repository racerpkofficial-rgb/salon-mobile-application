{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install --workspace=@aurelia/api --include-workspace-root=false",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/api/v1",
      "destination": "/api/index"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/terms",
      "destination": "/api/index"
    },
    {
      "source": "/privacy",
      "destination": "/api/index"
    }
  ]
}
