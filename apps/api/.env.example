PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/aurelia
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# This is the sole supported way to create the first SUPER_ADMIN. Never expose it in a mobile client.
SUPER_ADMIN_NAME=Platform Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-this-to-a-unique-password

# Cloudinary File Storage Configuration
# Required for persistent production asset storage (salon photos, avatars, offers, identity documents)
# In Vercel, configure these under Project Settings -> Environment Variables
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google Sign-In OAuth 2.0 Web Client ID (used for Web app & token verifier)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Google Sign-In OAuth 2.0 Android Client ID (required for Android APK token verification in production/Vercel)
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com
# Optional alias: GOOGLE_WEB_CLIENT_ID is also recognized by the backend if set instead of GOOGLE_CLIENT_ID
GOOGLE_WEB_CLIENT_ID=

# SMTP Email Delivery Configuration for Password Recovery & OTPs
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM="Book My Salon" <your-email@gmail.com>
MAIL_FROM="Book My Salon" <your-email@gmail.com>
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=false