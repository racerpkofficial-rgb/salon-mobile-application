{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["index.ts", "api/**/*.ts", "src/**/*.ts"],
  "exclude": [
    "node_modules",
    "scripts",
    "src/inspect_salons.ts",
    "src/test-*.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
